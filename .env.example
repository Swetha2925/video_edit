# ---------------------------------------------------------------
# ReelCraft AI — environment configuration (copy to .env)
# Never commit .env. All keys stay on the server.
# ---------------------------------------------------------------

# Product name shown in the UI (configurable)
NEXT_PUBLIC_APP_NAME="ReelCraft AI"

# Database (local development uses SQLite; see docs/ARCHITECTURE.md for PostgreSQL)
DATABASE_URL="file:./reelcraft.db"

# Anthropic Claude API — required for AI planning, asset analysis and creative review.
# Claude API usage is billed per token by Anthropic. Without a key, only the
# clearly-labelled "Basic assembly (no AI)" render path is available.
ANTHROPIC_API_KEY=
# Model used for creative reasoning (configurable)
ANTHROPIC_MODEL="claude-opus-5-5"
# Effort for creative planning calls: low | medium | high | xhigh | max
ANTHROPIC_EFFORT="high"

# Secret used to sign the local session cookie. Generate with: openssl rand -hex 32
# If empty in development, a random secret is generated and stored in storage/.session-secret
SESSION_SECRET=

# Storage root for uploads, thumbnails, renders (outside any public directory)
STORAGE_ROOT="./storage"

# Optional: override bundled FFmpeg / FFprobe binaries with system installs
FFMPEG_PATH=
FFPROBE_PATH=

# Limits (enforced server-side)
MAX_IMAGE_BYTES=41943040          # 40 MB
MAX_VIDEO_BYTES=1073741824        # 1 GB
MAX_AUDIO_BYTES=104857600         # 100 MB
MAX_VIDEO_DURATION_SEC=600        # 10 minutes per clip
MAX_ASSETS_PER_PROJECT=60
MAX_OUTPUT_DURATION_SEC=180
MAX_RENDERS_PER_PROJECT=40
MAX_MODEL_CALLS_PER_PROJECT=150
AUTO_FIX_RENDER_BUDGET=2          # automatic QC-driven re-renders per render request

# Render quality
RENDER_CRF=18                      # lower = higher quality / bigger files (H.264)
RENDER_PRESET="medium"             # x264 preset
RENDER_TIMEOUT_SEC=1800

# Force the Secure flag on the session cookie (set to true when served over HTTPS)
COOKIE_SECURE=false
